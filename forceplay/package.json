{
  "name": "kplay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KPlay Studio - Open-Core Playwright-Native Salesforce Test Automation Platform",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "studio": "pnpm --filter @kplay/studio start",
    "studio:server": "pnpm --filter @kplay/studio run server",
    "studio:ui": "pnpm --filter @kplay/studio run dev",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
