{
  "name": "kplay-studio-salesforce",
  "version": "1.0.0",
  "description": "KPlay Studio - Enterprise Salesforce Quality & Automation Platform",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:notes": "playwright test tests/rcm-notes-sync.spec.ts",
    "test:regression": "playwright test tests/generated/ --project=salesforce",
    "test:regression:headed": "playwright test tests/generated/ --project=salesforce --headed",
    "test:report": "playwright show-report",
    "auth:refresh": "playwright test tests/auth.setup.ts --project=setup",
    "studio": "pnpm --prefix forceplay --filter @kplay/studio start",
    "studio:server": "pnpm --prefix forceplay --filter @kplay/studio run server",
    "studio:ui": "pnpm --prefix forceplay --filter @kplay/studio run dev",
    "kplay:build": "pnpm --prefix forceplay -r run build",
    "suite:nightly": "pnpm --prefix forceplay --filter @kplay/studio exec tsx server/cli/run-suite.ts",
    "test:helpers": "playwright test -c tests-kplay/playwright.unit.config.ts",
    "test:parser": "node --test \"forceplay/packages/resolver/test/*.test.mjs\"",
    "fixture:capture": "npx tsx tests-kplay/capture-fixture.ts",
    "test:codegen": "node --test \"forceplay/packages/codegen/test/*.test.mjs\"",
    "test:unit": "pnpm --prefix forceplay -r run build && node --test \"forceplay/packages/resolver/test/*.test.mjs\" \"forceplay/packages/codegen/test/*.test.mjs\""
  },
  "keywords": [
    "salesforce",
    "crm",
    "automation",
    "testing",
    "kplay",
    "quality"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.22.1"
  }
}
